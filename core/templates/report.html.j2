<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suasiv — Coaching Report</title>
<style>
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b7280;
    --border: #e5e7eb;
    --surface: #f9fafb;
    --accent: #2563eb;
    --good: #16a34a;
    --fair: #ca8a04;
    --weak: #dc2626;
    --qa: #7c3aed;
    --turning: #0891b2;
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    max-width: 860px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.7;
  }
  h1 { border-bottom: 3px solid var(--accent); padding-bottom: 0.5rem; }
  h2 { color: var(--accent); margin-top: 2.5rem; }
  h3 { margin-top: 1.5rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }
  .meta strong { color: var(--fg); }

  /* Scores */
  .scores { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  .scores th, .scores td { padding: 0.6rem 0.8rem; text-align: left; border-bottom: 1px solid var(--border); }
  .scores th { background: var(--surface); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .score-bar-track { width: 200px; height: 10px; background: var(--border); border-radius: 5px; overflow: hidden; }
  .score-bar-fill { height: 100%; border-radius: 5px; transition: width 0.3s; }
  .score-bar-fill.good { background: var(--good); }
  .score-bar-fill.fair { background: var(--fair); }
  .score-bar-fill.weak { background: var(--weak); }
  .level { font-size: 0.8rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 3px; }
  .level.good { color: var(--good); background: #dcfce7; }
  .level.fair { color: var(--fair); background: #fef9c3; }
  .level.weak { color: var(--weak); background: #fee2e2; }

  /* Narrative */
  .narrative { margin: 1.5rem 0; }
  .narrative h3 { color: var(--fg); font-size: 1.15rem; }
  .narrative h4 { color: var(--muted); font-size: 1rem; }
  .narrative ul, .narrative ol { padding-left: 1.5rem; }
  .narrative li { margin: 0.4rem 0; }
  .narrative p { margin: 0.8rem 0; }
  .narrative .ts { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.85em; color: var(--accent); font-weight: 600; }

  /* Moments */
  .moment { border-left: 4px solid var(--border); padding: 0.8rem 1rem; margin: 1rem 0; border-radius: 0 6px 6px 0; background: var(--surface); }
  .moment.strong { border-left-color: var(--good); }
  .moment.weak { border-left-color: var(--weak); }
  .moment.qa { border-left-color: var(--qa); }
  .moment.turning_point { border-left-color: var(--turning); }
  .moment-header { font-weight: 600; margin-bottom: 0.3rem; }
  .moment-time { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.85em; color: var(--accent); }
  .moment-type { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.1rem 0.4rem; border-radius: 3px; margin-left: 0.5rem; }
  .moment-type.strong { background: #dcfce7; color: var(--good); }
  .moment-type.weak { background: #fee2e2; color: var(--weak); }
  .moment-type.qa { background: #ede9fe; color: var(--qa); }
  .moment-type.turning_point { background: #cffafe; color: var(--turning); }
  .moment-meta { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }

  /* Signal table */
  .signals { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .signals th, .signals td { padding: 0.4rem 0.6rem; text-align: left; border-bottom: 1px solid var(--border); }
  .signals th { background: var(--surface); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .signals td:first-child { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.85em; white-space: nowrap; }
  .overflow-x { overflow-x: auto; }

  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.8rem; }
</style>
</head>
<body>

<h1>Suasiv — Coaching Report</h1>

<p class="meta">
  <strong>Video:</strong> {{ metadata.get('video', 'N/A') }} &nbsp;·&nbsp;
  <strong>Duration:</strong> {{ metadata.get('duration', 0) | fmt_time }} &nbsp;·&nbsp;
  <strong>Analyzers:</strong> {{ metadata.get('analyzers_run', []) | join(', ') }}
</p>

{% if metadata.get('skipped_analyzers') or metadata.get('failed_analyzers') %}
<div style="background: #fef3c7; border: 1px solid #f59e0b; border-radius: 6px; padding: 0.8rem 1rem; margin: 1rem 0;">
  <strong style="color: #92400e;">Some analyzers were not run:</strong>
  {% if metadata.get('skipped_analyzers') %}
  <p style="margin: 0.3rem 0; color: #92400e;">
    <em>Skipped (disabled or missing data):</em> {{ metadata.get('skipped_analyzers', []) | join(', ') }}
  </p>
  {% endif %}
  {% if metadata.get('failed_analyzers') %}
  <p style="margin: 0.3rem 0; color: #92400e;"><em>Failed:</em></p>
  <ul style="margin: 0.2rem 0; color: #92400e;">
    {% for f in metadata.get('failed_analyzers', []) %}
    <li>{{ f.name }}: {{ f.reason }}</li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

<h2>Summary Scores</h2>
<div class="overflow-x">
<table class="scores">
  <tr><th>Dimension</th><th>Score</th><th></th><th>Level</th></tr>
  {% for dim, score in scores.items() %}
  {% set lvl = score | score_level %}
  {% set cls = 'good' if score >= 0.7 else ('fair' if score >= 0.4 else 'weak') %}
  <tr>
    <td>{{ dim | replace('_', ' ') | title }}</td>
    <td>{{ "%.0f"|format(score * 100) }}%</td>
    <td>
      <div class="score-bar-track">
        <div class="score-bar-fill {{ cls }}" style="width: {{ (score * 100) | int }}%;"></div>
      </div>
    </td>
    <td><span class="level {{ cls }}">{{ lvl }}</span></td>
  </tr>
  {% endfor %}
</table>
</div>

<h2>Coaching Analysis</h2>
<div class="narrative">{{ narrative | md }}</div>

<h2>Key Moments</h2>
{% if moments %}
{% for moment in moments %}
<div class="moment {{ moment.type }}">
  <div class="moment-header">
    <span class="moment-time">[{{ moment.start | fmt_time }} — {{ moment.end | fmt_time }}]</span>
    <span class="moment-type {{ moment.type }}">{{ moment.type | replace('_', ' ') | title }}</span>
  </div>
  <p>{{ moment.description }}</p>
  <div class="moment-meta">{{ moment.signals | length }} signals · significance {{ "%.0f"|format(moment.significance * 100) }}%</div>
</div>
{% endfor %}
{% else %}
<p>No significant moments detected.</p>
{% endif %}

<h2>Signal Timeline</h2>
<div class="overflow-x">
<table class="signals">
  <tr><th>Time</th><th>Analyzer</th><th>Signal</th><th>Value</th></tr>
  {% for signal in signals[:50] %}
  <tr>
    <td>{{ signal.start | fmt_time }}</td>
    <td>{{ signal.analyzer }}</td>
    <td>{{ signal.type | replace('_', ' ') }}</td>
    <td>{{ signal.value if signal.value is not none else '' }}</td>
  </tr>
  {% endfor %}
  {% if signals | length > 50 %}
  <tr><td colspan="4" style="color: var(--muted); text-align: center;">… {{ signals | length - 50 }} more signals</td></tr>
  {% endif %}
</table>
</div>

<footer>Generated by Suasiv — signals, not emotions.</footer>

</body>
</html>
