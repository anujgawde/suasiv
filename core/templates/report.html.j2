<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suasiv — Coaching Report</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.6; }
  h1 { border-bottom: 2px solid #2563eb; padding-bottom: 0.5rem; }
  h2 { color: #2563eb; margin-top: 2rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { padding: 0.5rem; text-align: left; border-bottom: 1px solid #e5e7eb; }
  th { background: #f9fafb; font-weight: 600; }
  .score-bar { display: inline-block; height: 1rem; background: #2563eb; border-radius: 4px; }
  .moment { background: #f9fafb; border-left: 3px solid #2563eb; padding: 1rem; margin: 1rem 0; border-radius: 0 4px 4px 0; }
  .moment.strong { border-left-color: #16a34a; }
  .moment.weak { border-left-color: #dc2626; }
  .moment.qa { border-left-color: #ca8a04; }
  .meta { color: #6b7280; font-size: 0.875rem; }
  .narrative { white-space: pre-wrap; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e5e7eb; color: #9ca3af; font-size: 0.8rem; }
</style>
</head>
<body>

<h1>Suasiv — Communication Coaching Report</h1>

<p class="meta">
  <strong>Video:</strong> {{ metadata.get('video', 'N/A') }} &nbsp;|&nbsp;
  <strong>Duration:</strong> {{ "%.1f"|format(metadata.get('duration', 0)) }}s &nbsp;|&nbsp;
  <strong>Analyzers:</strong> {{ metadata.get('analyzers_run', [])|join(', ') }}
</p>

<h2>Summary Scores</h2>
<table>
  <tr><th>Dimension</th><th>Score</th><th></th></tr>
  {% for dim, score in scores.items() %}
  <tr>
    <td>{{ dim | replace('_', ' ') | title }}</td>
    <td>{{ "%.0f"|format(score * 100) }}%</td>
    <td><span class="score-bar" style="width: {{ score * 200 }}px;"></span></td>
  </tr>
  {% endfor %}
</table>

<h2>Coaching Narrative</h2>
<div class="narrative">{{ narrative }}</div>

<h2>Key Moments</h2>
{% for moment in moments %}
<div class="moment {{ moment.type }}">
  <strong>[{{ "%.1f"|format(moment.start) }}s - {{ "%.1f"|format(moment.end) }}s]</strong>
  <em>{{ moment.type | title }}</em>
  <p>{{ moment.description }}</p>
</div>
{% endfor %}

<h2>Signal Timeline</h2>
<table>
  <tr><th>Time</th><th>Analyzer</th><th>Type</th><th>Value</th></tr>
  {% for signal in signals[:30] %}
  <tr>
    <td>{{ "%.1f"|format(signal.start) }}s</td>
    <td>{{ signal.analyzer }}</td>
    <td>{{ signal.type }}</td>
    <td>{{ signal.value if signal.value is not none else '' }}</td>
  </tr>
  {% endfor %}
</table>

<footer>Generated by Suasiv v0.1.0 — signals, not emotions.</footer>

</body>
</html>
